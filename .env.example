# Inventory System - Environment Variables
# Copy to .env and fill in your values

# ============================================
# BACKEND (Node.js + Fastify)
# ============================================
NODE_ENV=development
PORT=3001

# JWT Secret - CHANGE IN PRODUCTION! Use: openssl rand -base64 32
JWT_SECRET=inventory-secret-key-change-in-production

# Cookie Secret - CHANGE IN PRODUCTION!
COOKIE_SECRET=cookie-secret-change-in-production

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Database (if using PostgreSQL instead of in-memory)
# DATABASE_URL=postgresql://user:pass@localhost:5432/inventory

# ============================================
# FRONTEND (React + Vite)
# ============================================
VITE_API_URL=http://localhost:3001/api

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================

# Email (SMTP) for notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# Twilio for SMS
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890

# OpenAI Whisper API (for production voice)
# OPENAI_API_KEY=sk-xxxxxxxx

# ============================================
# DEVELOPMENT
# ============================================
# Enable debug logging
# DEBUG=*

# Disable voice in development if no mic
# DISABLE_VOICE=false